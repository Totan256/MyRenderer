#version 460
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;

struct VertexPosition { vec4 position; };
struct BVHNode {
    vec3 aabbMin; uint leftChildOrPrimitiveOffset;
    vec3 aabbMax; uint rightChildOrPrimitiveCount;
};
layout(set=0,binding=0) readonly buffer Positions { VertexPosition data[]; } positions[];
layout(set=0,binding=0) readonly buffer Indices { uint data[]; } indices[];
layout(set=0,binding=0) readonly buffer Nodes { BVHNode data[]; } nodes[];
layout(push_constant) uniform Push {
    uint swapchainImage;
    uint ModelPos;
    uint ModelIdx;
    uint ModelBvhNodes;
    uvec2 sceneGlobalsPtr;
} pc;

bool boxHit(vec3 o,vec3 d,vec3 lo,vec3 hi,float maxT) {
    float nearT=0.0, farT=maxT;
    for(int a=0;a<3;++a) {
        if(abs(d[a])<1e-8) { if(o[a]<lo[a] || o[a]>hi[a]) return false; }
        else {
            float x=(lo[a]-o[a])/d[a], y=(hi[a]-o[a])/d[a];
            nearT=max(nearT,min(x,y)); farT=min(farT,max(x,y));
            if(farT<nearT) return false;
        }
    }
    return true;
}
bool triangleHit(vec3 o,vec3 d,vec3 a,vec3 b,vec3 c,out float t) {
    vec3 e1=b-a,e2=c-a,p=cross(d,e2);
    float det=dot(e1,p);
    if(abs(det)<1e-4) return false;
    float inv=1.0/det;
    vec3 s=o-a;
    float u=dot(s,p)*inv;
    if(u<0.0 || u>1.0) return false;
    vec3 q=cross(s,e1);
    float v=dot(d,q)*inv;
    if(v<0.0 || u+v>1.0) return false;
    t=dot(e2,q)*inv;
    return t>0.0001;
}
void main() {
    ivec2 localPixel=ivec2(gl_GlobalInvocationID.xy);
    Scene s=scenes[nonuniformEXT(pc.sceneGlobalsPtr.x)].data;
    int halfWidth=(int(s.resolutionFov.x)+1)/2;
    int rightWidth=int(s.resolutionFov.x)-halfWidth;
    if(localPixel.x>=rightWidth || localPixel.y>=int(s.resolutionFov.y)) return;
    vec3 o,d; makeRay(localPixel,s,o,d);
    float closest=s.infer.w;
    vec3 n=vec3(0);
    uint stack[64]; int sp=0; stack[sp++]=0;
    while(sp>0) {
        BVHNode node=nodes[nonuniformEXT(pc.ModelBvhNodes)].data[stack[--sp]];
        if(!boxHit(o,d,node.aabbMin,node.aabbMax,closest)) continue;
        if(node.rightChildOrPrimitiveCount==0) {
            if(sp+2>64) break; // Matches the sandbox's 64-entry traversal stack limit.
            stack[sp++]=node.leftChildOrPrimitiveOffset+1;
            stack[sp++]=node.leftChildOrPrimitiveOffset;
        } else {
            for(uint i=0;i<node.rightChildOrPrimitiveCount;++i) {
                uint base=(node.leftChildOrPrimitiveOffset+i)*3;
                uint a=indices[nonuniformEXT(pc.ModelIdx)].data[base];
                uint b=indices[nonuniformEXT(pc.ModelIdx)].data[base+1];
                uint c=indices[nonuniformEXT(pc.ModelIdx)].data[base+2];
                vec3 va=positions[nonuniformEXT(pc.ModelPos)].data[a].position.xyz;
                vec3 vb=positions[nonuniformEXT(pc.ModelPos)].data[b].position.xyz;
                vec3 vc=positions[nonuniformEXT(pc.ModelPos)].data[c].position.xyz;
                float t;
                if(triangleHit(o,d,va,vb,vc,t) && t<closest) { closest=t; n=normalize(cross(vb-va,vc-va)); }
            }
        }
    }
    vec3 color=closest<s.infer.w ? normalColor(n) : background;
    imageStore(storageImages[nonuniformEXT(pc.swapchainImage)],localPixel+ivec2(halfWidth,0),vec4(color,1));
}
