#version 460
#extension GL_EXT_nonuniform_qualifier : require

// 8x8 = 64スレッドのワークグループ
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct VertexPosition {
    vec4 position;
};
struct VertexAttributes {
    vec4 normal;
    vec2 uv;
    vec2 padding;
};

// ==========================================
// Bindless Descriptor Sets
// ==========================================

// Binding 0: Storage Buffers (構造体の異なるSSBO配列を同じbindingにエイリアシング)
layout(set = 0, binding = 0) readonly buffer PositionBuffers  { VertexPosition data[]; } positionBuffers[];
layout(set = 0, binding = 0) readonly buffer AttributeBuffers { VertexAttributes data[]; } attributeBuffers[];
layout(set = 0, binding = 0) readonly buffer IndexBuffers     { uint data[]; } indexBuffers[];

// Binding 1: Storage Images (出力先スワップチェーン)
layout(set = 0, binding = 1) uniform writeonly image2D storageImages[];

// Binding 2: Uniform Buffers (共通パラメータ用UBO配列)
layout(set = 0, binding = 2) uniform UniformBuffers {
    vec4 data[4096]; // 16バイト(vec4)単位のプールとして受ける
} ubos[];

// ==========================================
// Push Constants (インデックスとUBOポインタ情報のみ)
// ==========================================
layout(push_constant) uniform PushConstants {
    uint ModelPos;
    uint ModelAttr;
    uint ModelIdx;
    uint swapchainImage; // C++側で自動解決された最新のバックバッファのインデックスが入る
    
    // エンジン仕様(index, offset)に合わせた uvec2 型のUBOポインタ
    uvec2 camPos_time;
    uvec2 camTarget_numIdx;
    uvec2 resolution_fov;
} pc;

// ==========================================
// UBOデータ取得ヘルパー関数
// ==========================================
vec4 getUniformVec4(uvec2 uboPtr) {
    uint uboIdx = uboPtr.x;
    uint offsetBytes = uboPtr.y;
    // dataはvec4(16バイト)配列なので、バイトオフセットを16で割る
    return ubos[nonuniformEXT(uboIdx)].data[offsetBytes / 16];
}

// ==========================================
// Main Execution
// ==========================================
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    // 1. UBOから解像度を安全に取得
    vec2 resolution = getUniformVec4(pc.resolution_fov).xy;
    if (pixel.x >= resolution.x || pixel.y >= resolution.y) return;

    // 2. UBOからカメラ位置・時間を取得
    vec4 camPos_time = getUniformVec4(pc.camPos_time);
    float time = camPos_time.w;

    // 3. ピクセル座標を0.0〜1.0に正規化してUVを作る
    vec2 uv = vec2(pixel) / resolution;

    // 4. UV座標と時間を使ってグラデーションを作る
    // X軸で赤、Y軸で緑、時間経過で青が変化するグラデーション
    vec3 color = vec3(uv.x, uv.y+abs(cos(time)), abs(sin(time)));

    // 5. (おまけ) SSBOへのアクセス確認
    // モデルが正しく読み込めていれば、画面全体を少し明るくする
    uint vertexId = indexBuffers[nonuniformEXT(pc.ModelIdx)].data[0];
    vec3 testPos = positionBuffers[nonuniformEXT(pc.ModelPos)].data[vertexId].position.xyz;
    if (length(testPos) > 0.0) {
        color += vec3(0.1); 
    }

    // 6. スワップチェーン画像への書き込み
    imageStore(storageImages[nonuniformEXT(pc.swapchainImage)], pixel, vec4(color, 1.0));
}